{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Animation Forge",
  "version": "1.0.0",
  "identifier": "studio.animationforge.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Animation Forge \u2014 Production Operating System",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/animation-forge-backend"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
