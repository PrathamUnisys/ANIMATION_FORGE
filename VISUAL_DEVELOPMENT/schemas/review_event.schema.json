{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-forge.local/visual-development/review_event.schema.json",
  "title": "ReviewEvent",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "actor",
    "action",
    "target_type",
    "target_id"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "actor": { "type": "string" },
    "action": {
      "type": "string",
      "enum": ["SELECT", "APPROVE", "REJECT", "REQUEST_REVISION", "REGENERATE", "NOTE"]
    },
    "target_type": { "type": "string" },
    "target_id": { "type": "string" },
    "note": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
