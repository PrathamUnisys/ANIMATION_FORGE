{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-forge.local/visual-development/generation_manifest.schema.json",
  "title": "GenerationManifest",
  "type": "object",
  "required": ["generation_id", "image_path", "image_sha256", "created_at"],
  "properties": {
    "generation_id": { "type": "string" },
    "image_path": { "type": "string" },
    "image_sha256": { "type": "string" },
    "created_at": { "type": "string" },
    "artifact_type": { "type": "string" },
    "shot_id": { "type": "string" },
    "sequence_id": { "type": "string" },
    "scene_id": { "type": "string" },
    "prompt": { "type": "string" },
    "negative_prompt": { "type": "string" },
    "workflow_id": { "type": "string" },
    "workflow_version": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "lora": { "type": ["string", "null"] },
    "lora_strength": { "type": ["number", "null"] },
    "seed": { "type": "integer" },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "steps": { "type": "integer" },
    "cfg": { "type": "number" },
    "sampler": { "type": "string" },
    "scheduler": { "type": "string" },
    "reference_images": { "type": "array", "items": { "type": "string" } },
    "style_bible_sha256": { "type": "string" },
    "source_script_sha256": { "type": "string" },
    "comfyui_prompt_id": { "type": "string" },
    "status": { "type": "string" },
    "error": { "type": "string" }
  },
  "additionalProperties": true
}
