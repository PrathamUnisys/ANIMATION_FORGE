{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimationForgeEpisodeBrief",
  "type": "object",
  "additionalProperties": true,
  "required": ["project_id", "title", "premise", "synopsis", "primary_genre_id", "protagonist", "objective", "conflict", "stakes", "ending_direction"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PROJECT_[A-Z0-9_]+$"},
    "episode_id": {"type": "string"},
    "series_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "premise": {"type": "string", "minLength": 1},
    "synopsis": {"type": "string"},
    "primary_genre_id": {"type": "string"},
    "secondary_genre_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "channel_style_id": {"type": ["string", "null"]},
    "audience": {"type": "string"},
    "language": {"type": "string"},
    "target_runtime_sec": {"type": "integer", "minimum": 5},
    "tone": {"type": "string"},
    "visual_direction": {"type": "string"},
    "protagonist": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "conflict": {"type": "string", "minLength": 1},
    "opposition": {"type": "string"},
    "stakes": {"type": "string", "minLength": 1},
    "story_question": {"type": "string"},
    "characters": {"type": "array", "items": {"type": "string"}},
    "locations": {"type": "array", "items": {"type": "string"}},
    "clues_and_reveals": {"type": "array", "items": {"type": "string"}},
    "emotional_beats": {"type": "array", "items": {"type": "string"}},
    "ending_direction": {"type": "string", "minLength": 1},
    "required_beats": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "relationship_to_canon": {"type": "string"}
  }
}
