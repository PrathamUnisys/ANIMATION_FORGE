{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimationForgeChannelStyleRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "channels"],
  "properties": {
    "registry_version": {"type": "string"},
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_style_id", "display_name", "guide_path", "version", "status", "platforms", "tags"],
        "properties": {
          "channel_style_id": {"type": "string", "pattern": "^STYLE_[A-Z0-9_]+$"},
          "display_name": {"type": "string", "minLength": 1},
          "guide_path": {"type": "string", "pattern": "^STYLES/.+/STYLE_GUIDE\\.md$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "status": {"enum": ["ACTIVE", "DRAFT", "RETIRED"]},
          "platforms": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
