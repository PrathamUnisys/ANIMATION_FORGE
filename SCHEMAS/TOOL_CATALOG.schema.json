{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimationForgeToolCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "task_groups",
    "tools",
    "providers"
  ],
  "properties": {
    "catalog_version": {
      "type": "string"
    },
    "task_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "display_name",
          "tags",
          "candidate_tool_ids"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "display_name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "candidate_tool_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "candidate_provider_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "AnimationForgeToolProfile",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "display_name",
          "category",
          "manual_path",
          "official_docs",
          "tasks",
          "capability_tags",
          "availability_status",
          "integration_status",
          "connection_type",
          "default_endpoint_reference",
          "verified_version",
          "last_verified_at",
          "evidence",
          "limitations"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "manual_path": {
            "type": "string",
            "pattern": "^TOOLS/.+/TOOL\\.md$"
          },
          "official_docs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "tasks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "capability_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "availability_status": {
            "enum": [
              "NOT_VERIFIED",
              "NOT_INSTALLED",
              "INSTALLED",
              "CONNECTED",
              "CONFIGURATION_REQUIRED",
              "BLOCKED"
            ]
          },
          "integration_status": {
            "enum": [
              "DOCUMENTED_ONLY",
              "SIMULATION_ONLY",
              "ADAPTER_IMPLEMENTED",
              "END_TO_END_VERIFIED"
            ]
          },
          "connection_type": {
            "enum": [
              "LOCAL_PROCESS",
              "LOCAL_HTTP_WEBSOCKET",
              "REMOTE_API",
              "PLUGIN",
              "MANUAL",
              "UNKNOWN"
            ]
          },
          "default_endpoint_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "checked_at",
                "method",
                "result"
              ],
              "properties": {
                "checked_at": {
                  "type": "string"
                },
                "machine_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "method": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "evidence_uri": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "profile_paths",
          "category",
          "capability_tags",
          "integration_status",
          "limitations"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "profile_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^PROVIDERS/.+\\.md$"
            }
          },
          "category": {
            "type": "string"
          },
          "capability_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "integration_status": {
            "enum": [
              "DOCUMENTED_ONLY",
              "SIMULATION_ONLY",
              "ADAPTER_IMPLEMENTED",
              "END_TO_END_VERIFIED"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
