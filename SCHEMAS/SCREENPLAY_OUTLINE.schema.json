{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimationForgeScreenplayOutline",
  "type": "object",
  "additionalProperties": true,
  "required": ["acts", "beats"],
  "properties": {
    "acts": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"name": {"type": "string"}, "beats": {"type": "array", "items": {"type": "string"}}}}},
    "beats": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "description": {"type": "string"}}}},
    "status": {"type": "string", "enum": ["PROPOSED", "APPROVED", "REJECTED"]}
  }
}
