{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-forge.local/schemas/retention-map.schema.json",
  "title": "Animation Forge Retention Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "script_revision_id",
    "status",
    "beats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "script_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "NEEDS_REVIEW",
        "ACCEPTED",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "method_note": {
      "type": "string",
      "description": "State whether timecodes are rough estimates, script estimates or measured values."
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat_id",
          "scene_id",
          "narrative_function",
          "viewer_state",
          "viewer_question",
          "new_info_revealed",
          "emotional_tone",
          "visual_focus",
          "review_status"
        ],
        "properties": {
          "beat_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "timecode_start_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "target_duration_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "timing_basis": {
            "type": "string",
            "enum": [
              "ROUGH_ESTIMATE",
              "SCRIPT_ESTIMATE",
              "ANIMATIC_MEASURED",
              "FINAL_VIDEO_MEASURED",
              "NOT_SET"
            ]
          },
          "narrative_function": {
            "type": "string",
            "enum": [
              "HOOK",
              "SETUP",
              "INVESTIGATION",
              "CLUE",
              "ESCALATION",
              "REVERSAL",
              "MIDPOINT",
              "CLIMAX",
              "REVEAL",
              "RESOLUTION",
              "SERIES_TEASER",
              "TRANSITION",
              "OTHER"
            ]
          },
          "viewer_state": {
            "type": "string"
          },
          "viewer_question": {
            "type": "string"
          },
          "new_info_revealed": {
            "type": "string"
          },
          "emotional_tone": {
            "type": "string"
          },
          "pacing_note": {
            "type": "string"
          },
          "visual_focus": {
            "type": "string"
          },
          "audio_focus": {
            "type": "string"
          },
          "payoff_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retention_risk_hypothesis": {
            "type": "string"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "NEEDS_REVIEW",
              "ACCEPTED",
              "REJECTED",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    }
  }
}
