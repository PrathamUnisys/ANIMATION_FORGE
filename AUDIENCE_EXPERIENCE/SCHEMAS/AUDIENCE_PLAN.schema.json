{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-forge.local/schemas/audience-plan.schema.json",
  "title": "Animation Forge Audience Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "audience_promise",
    "primary_genre_id",
    "format_id",
    "format_type",
    "hook_options",
    "packaging_ref",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "audience_promise": {
      "type": "string",
      "minLength": 1
    },
    "intended_audience": {
      "type": "string"
    },
    "primary_genre_id": {
      "type": "string",
      "minLength": 1
    },
    "secondary_genre_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "format_id": {
      "type": "string",
      "minLength": 1
    },
    "format_type": {
      "type": "string",
      "enum": [
        "ANIMATED_LONG_FORM",
        "YOUTUBE_SHORT",
        "SHORT_EPISODE",
        "OTHER"
      ]
    },
    "target_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "central_question": {
      "type": "string"
    },
    "hook_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hook_id",
          "hook_type",
          "opening_concept",
          "viewer_question",
          "fulfilment_scene_ids",
          "status"
        ],
        "properties": {
          "hook_id": {
            "type": "string"
          },
          "hook_type": {
            "type": "string",
            "enum": [
              "MYSTERY",
              "VISUAL_ANOMALY",
              "EMOTIONAL",
              "SUPERNATURAL",
              "SUSPENSE",
              "OTHER"
            ]
          },
          "opening_concept": {
            "type": "string"
          },
          "opening_line": {
            "type": "string"
          },
          "viewer_question": {
            "type": "string"
          },
          "fulfilment_scene_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "SELECTED",
              "REJECTED"
            ]
          }
        }
      }
    },
    "packaging_ref": {
      "type": "string",
      "description": "Reference to a separate record conforming to packaging-options.schema.json."
    },
    "selected_hook_id": {
      "type": "string"
    },
    "retention_map_ref": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "NEEDS_REVIEW",
        "ACCEPTED",
        "REJECTED",
        "DEFERRED"
      ]
    }
  }
}
